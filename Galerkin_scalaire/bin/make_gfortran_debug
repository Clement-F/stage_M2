#####################################################
# Definition of the comilation commands (FC and LD) #
#  and the compilation options (FFLAGS et LDFLAGS)  #
#####################################################
FC	= gfortran
LD	= gfortran

FFLAGS  = -g -C -fbacktrace -Wtarget-lifetime -Wcompare-reals -Wrealloc-lhs-all -Wrealloc-lhs -Wintrinsic-shadow -Wunderflow -Wintrinsics-std -Wimplicit-procedure -Wconversion -Wconversion-extra -Wline-truncation -Wcharacter-truncation -Wc-binding-type -Waliasing -ffpe-trap=zero,overflow,underflow -fopenmp
LDFLAGS = -g -C -fbacktrace -Wtarget-lifetime -Wcompare-reals -Wrealloc-lhs-all -Wrealloc-lhs -Wintrinsic-shadow -Wunderflow -Wintrinsics-std -Wimplicit-procedure -Wconversion -Wconversion-extra -Wline-truncation -Wcharacter-truncation -Wc-binding-type -Waliasing -ffpe-trap=zero,overflow,underflow -fopenmp
